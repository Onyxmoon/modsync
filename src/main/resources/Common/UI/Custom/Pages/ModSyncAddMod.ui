$C = "ModSyncCommon.ui";

Group {
  Anchor: (Width: 500, Height: 350);
  Background: $C.@PanelBackground;
  LayoutMode: Top;
  Padding: (Full: 20);

  Label #title {
    Text: "Add Mod";
    Anchor: (Height: 40);
    Style: (
      FontSize: 24,
      TextColor: $C.@TextPrimary,
      HorizontalAlignment: Center,
      RenderBold: true
    );
  }

  Group {
    Anchor: (Height: 1);
    Background: $C.@DividerColor;
  }

  Group { Anchor: (Height: 16); }

  Group {
    LayoutMode: Left;
    Anchor: (Height: 44);

    Label {
      Text: "URL";
      Anchor: (Width: 60);
      Style: (FontSize: 14, TextColor: $C.@TextSecondary, VerticalAlignment: Center);
    }

    TextField #urlInput {
      Style: $C.@DefaultInputFieldStyle;
      PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle;
      Background: $C.@ContentBackground;
      FlexWeight: 1;
      Padding: (Horizontal: 10);
      PlaceholderText: "Enter mod URL...";
    }
  }

  Group { Anchor: (Height: 8); }

  Label #providerInfo {
    Text: "";
    Anchor: (Height: 24);
    Style: (FontSize: 12, TextColor: $C.@TextMuted, HorizontalAlignment: Start);
  }

  Group { Anchor: (Height: 8); }

  Label #errorMessage {
    Text: "";
    Anchor: (Height: 24);
    Style: (FontSize: 12, TextColor: $C.@TextError, HorizontalAlignment: Start);
  }

  Group { Anchor: (Height: 16); }

  Group #modInfo {
    Anchor: (Height: 80);
    Background: $C.@ContentBackground;
    Padding: (Full: 12);
    LayoutMode: Top;

    Label #modName {
      Text: "";
      Anchor: (Height: 24);
      Style: (FontSize: 16, TextColor: $C.@TextPrimary, RenderBold: true);
    }

    Label #modSlug {
      Text: "";
      Anchor: (Height: 20);
      Style: (FontSize: 12, TextColor: $C.@TextSecondary);
    }

    Label #modProvider {
      Text: "";
      Anchor: (Height: 20);
      Style: (FontSize: 12, TextColor: $C.@TextMuted);
    }
  }

  Group { FlexWeight: 1; }

  Group {
    LayoutMode: Center;
    Anchor: (Height: 44);

    TextButton #fetchBtn {
      Text: "Fetch";
      Anchor: (Width: 100, Height: 36);
      Style: $C.@SecondaryButtonStyle;
    }

    Group { Anchor: (Width: 12); }

    TextButton #addBtn {
      Text: "Add";
      Anchor: (Width: 100, Height: 36);
      Style: $C.@PrimaryButtonStyle;
    }

    Group { Anchor: (Width: 12); }

    TextButton #backBtn {
      Text: "Back";
      Anchor: (Width: 80, Height: 36);
      Style: $C.@SecondaryButtonStyle;
    }
  }
}
