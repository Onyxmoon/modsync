$C = "ModSyncCommon.ui";

Group {
  Anchor: (Width: 550, Height: 450);
  Background: $C.@PanelBackground;
  LayoutMode: Top;
  Padding: (Full: 20);

  Label #modName {
    Text: "";
    Anchor: (Height: 40);
    Style: (
      FontSize: 24,
      TextColor: $C.@TextPrimary,
      HorizontalAlignment: Center,
      RenderBold: true
    );
  }

  Group {
    Anchor: (Height: 1);
    Background: $C.@DividerColor;
  }

  Group { Anchor: (Height: 16); }

  Group {
    LayoutMode: Left;
    Anchor: (Height: 28);

    Label { Text: "Source:"; Anchor: (Width: 120); Style: (FontSize: 13, TextColor: $C.@TextSecondary); }
    Label #modSource { Text: ""; FlexWeight: 1; Style: (FontSize: 13, TextColor: $C.@TextPrimary); }
  }

  Group {
    LayoutMode: Left;
    Anchor: (Height: 28);

    Label { Text: "Mod ID:"; Anchor: (Width: 120); Style: (FontSize: 13, TextColor: $C.@TextSecondary); }
    Label #modId { Text: ""; FlexWeight: 1; Style: (FontSize: 13, TextColor: $C.@TextPrimary); }
  }

  Group {
    LayoutMode: Left;
    Anchor: (Height: 28);

    Label { Text: "Slug:"; Anchor: (Width: 120); Style: (FontSize: 13, TextColor: $C.@TextSecondary); }
    Label #modSlug { Text: ""; FlexWeight: 1; Style: (FontSize: 13, TextColor: $C.@TextPrimary); }
  }

  Group {
    LayoutMode: Left;
    Anchor: (Height: 28);

    Label { Text: "Identifier:"; Anchor: (Width: 120); Style: (FontSize: 13, TextColor: $C.@TextSecondary); }
    Label #modIdentifier { Text: ""; FlexWeight: 1; Style: (FontSize: 13, TextColor: $C.@TextPrimary); }
  }

  Group {
    LayoutMode: Left;
    Anchor: (Height: 28);

    Label { Text: "Type:"; Anchor: (Width: 120); Style: (FontSize: 13, TextColor: $C.@TextSecondary); }
    Label #modType { Text: ""; FlexWeight: 1; Style: (FontSize: 13, TextColor: $C.@TextPrimary); }
  }

  Group { Anchor: (Height: 12); }

  Group {
    Anchor: (Height: 1);
    Background: $C.@DividerColorLight;
  }

  Group { Anchor: (Height: 12); }

  Label {
    Text: "INSTALLATION";
    Anchor: (Height: 20);
    Style: $C.@SectionHeaderStyle;
  }

  Group { Anchor: (Height: 8); }

  Group {
    LayoutMode: Left;
    Anchor: (Height: 28);

    Label { Text: "Status:"; Anchor: (Width: 120); Style: (FontSize: 13, TextColor: $C.@TextSecondary); }
    Label #isInstalled { Text: ""; FlexWeight: 1; Style: (FontSize: 13, TextColor: $C.@TextPrimary); }
  }

  Group {
    LayoutMode: Left;
    Anchor: (Height: 28);

    Label { Text: "Version:"; Anchor: (Width: 120); Style: (FontSize: 13, TextColor: $C.@TextSecondary); }
    Label #installedVersion { Text: ""; FlexWeight: 1; Style: (FontSize: 13, TextColor: $C.@TextPrimary); }
  }

  Group {
    LayoutMode: Left;
    Anchor: (Height: 28);

    Label { Text: "File:"; Anchor: (Width: 120); Style: (FontSize: 13, TextColor: $C.@TextSecondary); }
    Label #installedFile { Text: ""; FlexWeight: 1; Style: (FontSize: 13, TextColor: $C.@TextPrimary); }
  }

  Group { FlexWeight: 1; }

  Label #statusMessage {
    Text: "";
    Anchor: (Height: 24);
    Style: (FontSize: 12, TextColor: $C.@TextSecondary, HorizontalAlignment: Center);
  }

  Group { Anchor: (Height: 8); }

  Group {
    LayoutMode: Center;
    Anchor: (Height: 44);

    TextButton #installBtn {
      Text: "Install";
      Anchor: (Width: 90, Height: 36);
      Style: $C.@PrimaryButtonStyle;
    }

    Group { Anchor: (Width: 8); }

    TextButton #upgradeBtn {
      Text: "Upgrade";
      Anchor: (Width: 90, Height: 36);
      Style: $C.@SecondaryButtonStyle;
    }

    Group { Anchor: (Width: 8); }

    TextButton #uninstallBtn {
      Text: "Uninstall";
      Anchor: (Width: 90, Height: 36);
      Style: $C.@SecondaryButtonStyle;
    }

    Group { Anchor: (Width: 8); }

    TextButton #removeBtn {
      Text: "Remove";
      Anchor: (Width: 90, Height: 36);
      Style: $C.@DangerButtonStyle;
    }

    Group { Anchor: (Width: 16); }

    TextButton #backBtn {
      Text: "Back";
      Anchor: (Width: 70, Height: 36);
      Style: $C.@SecondaryButtonStyle;
    }
  }
}
