$C = "ModSyncCommon.ui";

Group {
  Anchor: (Width: 550, Height: 500);
  Background: $C.@PanelBackground;
  LayoutMode: Top;
  Padding: (Full: 20);

  Group {
    LayoutMode: Left;
    Anchor: (Height: 45);

    Label #title {
      Text: "ModSync Settings";
      Anchor: (Width: 250);
      Style: $C.@TitleStyle;
    }

    Group { FlexWeight: 1; }

    TextButton #backBtn {
      Text: "Back";
      Anchor: (Width: 70, Height: 32);
      Style: $C.@SecondaryButtonStyle;
    }
  }

  Group {
    Anchor: (Height: 1);
    Background: $C.@DividerColor;
  }

  Group { Anchor: (Height: 16); }

  Label {
    Text: "VERSION";
    Anchor: (Height: 18);
    Style: $C.@SectionHeaderStyle;
  }

  Group { Anchor: (Height: 8); }

  Group {
    LayoutMode: Left;
    Anchor: (Height: 32);

    Label { Text: "Current Version:"; Anchor: (Width: 140); Style: (FontSize: 13, TextColor: $C.@TextSecondary, VerticalAlignment: Center); }
    Label #version { Text: ""; Anchor: (Width: 80); Style: (FontSize: 13, TextColor: $C.@TextPrimary, VerticalAlignment: Center); }

    Group { Anchor: (Width: 16); }

    Label #updateStatus { Text: ""; FlexWeight: 1; Style: (FontSize: 12, TextColor: $C.@TextMuted, VerticalAlignment: Center); }

    TextButton #checkUpdateBtn {
      Text: "Check";
      Anchor: (Width: 70, Height: 28);
      Style: $C.@SecondaryButtonStyle;
    }

    Group { Anchor: (Width: 8); }

    TextButton #upgradeBtn {
      Text: "Upgrade";
      Anchor: (Width: 80, Height: 28);
      Style: $C.@SuccessButtonStyle;
    }
  }

  Group { Anchor: (Height: 16); }

  Group {
    Anchor: (Height: 1);
    Background: $C.@DividerColorLight;
  }

  Group { Anchor: (Height: 16); }

  Label {
    Text: "CONFIGURATION";
    Anchor: (Height: 18);
    Style: $C.@SectionHeaderStyle;
  }

  Group { Anchor: (Height: 8); }

  Group {
    LayoutMode: Left;
    Anchor: (Height: 28);

    Label { Text: "Update Mode:"; Anchor: (Width: 140); Style: (FontSize: 13, TextColor: $C.@TextSecondary, VerticalAlignment: Center); }
    Label #updateMode { Text: ""; FlexWeight: 1; Style: (FontSize: 13, TextColor: $C.@TextPrimary, VerticalAlignment: Center); }
  }

  Group {
    LayoutMode: Left;
    Anchor: (Height: 28);

    Label { Text: "Release Channel:"; Anchor: (Width: 140); Style: (FontSize: 13, TextColor: $C.@TextSecondary, VerticalAlignment: Center); }
    Label #defaultChannel { Text: ""; FlexWeight: 1; Style: (FontSize: 13, TextColor: $C.@TextPrimary, VerticalAlignment: Center); }
  }

  Group { Anchor: (Height: 16); }

  Group {
    Anchor: (Height: 1);
    Background: $C.@DividerColorLight;
  }

  Group { Anchor: (Height: 16); }

  Label {
    Text: "API KEYS";
    Anchor: (Height: 18);
    Style: $C.@SectionHeaderStyle;
  }

  Group { Anchor: (Height: 8); }

  Group #providersContainer {
    FlexWeight: 1;
    LayoutMode: Top;
    Background: $C.@ContentBackground;
    Padding: (Full: 8);
  }

  Group { Anchor: (Height: 12); }

  Group {
    LayoutMode: Left;
    Anchor: (Height: 40);

    TextButton #reloadBtn {
      Text: "Reload Config";
      Anchor: (Width: 120, Height: 34);
      Style: $C.@SecondaryButtonStyle;
    }

    Group { FlexWeight: 1; }

    Label #statusMessage {
      Text: "";
      FlexWeight: 1;
      Style: (FontSize: 12, TextColor: $C.@TextSecondary, HorizontalAlignment: End, VerticalAlignment: Center);
    }
  }
}
