$C = "ModSyncCommon.ui";

Group {
  Anchor: (Width: 650, Height: 500);
  Background: $C.@PanelBackground;
  LayoutMode: Top;
  Padding: (Full: 20);

  Group {
    LayoutMode: Left;
    Anchor: (Height: 45);

    Label #title {
      Text: "Scan Unmanaged Mods";
      Anchor: (Width: 300);
      Style: $C.@TitleStyle;
    }

    Group { FlexWeight: 1; }

    TextButton #rescanBtn {
      Text: "Rescan";
      Anchor: (Width: 80, Height: 32);
      Style: $C.@SecondaryButtonStyle;
    }

    Group { Anchor: (Width: 8); }

    TextButton #backBtn {
      Text: "Back";
      Anchor: (Width: 70, Height: 32);
      Style: $C.@SecondaryButtonStyle;
    }
  }

  Group {
    Anchor: (Height: 1);
    Background: $C.@DividerColor;
  }

  Group { Anchor: (Height: 12); }

  Label #summary {
    Text: "";
    Anchor: (Height: 24);
    Style: (FontSize: 13, TextColor: $C.@TextSecondary, HorizontalAlignment: Start);
  }

  Group { Anchor: (Height: 8); }

  Group #modListContainer {
    FlexWeight: 1;
    LayoutMode: Top;
    Background: $C.@ContentBackground;
    Padding: (Full: 8);
  }

  Group { Anchor: (Height: 12); }

  Group {
    LayoutMode: Left;
    Anchor: (Height: 40);

    TextButton #importAllBtn {
      Text: "Import All (High Confidence)";
      Anchor: (Width: 200, Height: 34);
      Style: $C.@SuccessButtonStyle;
    }

    Group { FlexWeight: 1; }

    Label #statusMessage {
      Text: "";
      FlexWeight: 1;
      Style: (FontSize: 12, TextColor: $C.@TextSecondary, HorizontalAlignment: End, VerticalAlignment: Center);
    }
  }
}
