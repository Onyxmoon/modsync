$C = "ModSyncCommon.ui";

Group {
  Anchor: (Width: 600, Height: 500);
  Background: $C.@PanelBackground;
  LayoutMode: Top;
  Padding: (Full: 20);

  Group {
    LayoutMode: Left;
    Anchor: (Height: 45);

    Label #title {
      Text: "ModSync";
      Anchor: (Width: 200);
      Style: $C.@BigTitleStyle;
    }

    Group { FlexWeight: 1; }

    Label #version {
      Text: "";
      Anchor: (Width: 80);
      Style: (FontSize: 12, TextColor: $C.@TextMuted, HorizontalAlignment: End, VerticalAlignment: Center);
    }
  }

  Group {
    Anchor: (Height: 1);
    Background: $C.@DividerColor;
  }

  Group { Anchor: (Height: 12); }

  Group {
    LayoutMode: Left;
    Anchor: (Height: 36);

    TextButton #addBtn {
      Text: "Add Mod";
      Anchor: (Width: 90, Height: 32);
      Style: $C.@PrimaryButtonStyle;
    }

    Group { Anchor: (Width: 8); }

    TextButton #scanBtn {
      Text: "Scan";
      Anchor: (Width: 70, Height: 32);
      Style: $C.@SecondaryButtonStyle;
    }

    Group { Anchor: (Width: 8); }

    TextButton #settingsBtn {
      Text: "Settings";
      Anchor: (Width: 80, Height: 32);
      Style: $C.@SecondaryButtonStyle;
    }

    Group { FlexWeight: 1; }

    Label #summary {
      Text: "";
      Anchor: (Width: 150);
      Style: (FontSize: 12, TextColor: $C.@TextSecondary, HorizontalAlignment: End, VerticalAlignment: Center);
    }
  }

  Group { Anchor: (Height: 12); }

  Group {
    Anchor: (Height: 1);
    Background: $C.@DividerColorLight;
  }

  Group { Anchor: (Height: 12); }

  Group #modListContainer {
    FlexWeight: 1;
    LayoutMode: TopScrolling;
    Background: $C.@ContentBackground;
    Padding: (Full: 8);

    // Empty state message (hidden when mods exist)
    Label #emptyMessage {
      Text: "No mods managed yet. Use 'Add Mod' to add your first mod.";
      Style: (
        FontSize: 14,
        TextColor: $C.@TextMuted,
        HorizontalAlignment: Center,
        VerticalAlignment: Center
      );
    }
  }

  Group { Anchor: (Height: 12); }

  Group #statusContainer {
    Anchor: (Height: 24);
    LayoutMode: Left;

    Label #statusMessage {
      Text: "";
      FlexWeight: 1;
      Style: (FontSize: 12, TextColor: $C.@TextSecondary, VerticalAlignment: Center);
    }
  }
}
